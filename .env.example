# Required for `journey-agent build` and `journey-agent run` (real mode).
# Not needed for `journey-agent demo` or the test suite -- both run
# entirely offline against a FakeLLM and a bundled fixture site.
ANTHROPIC_API_KEY=sk-ant-...

# Optional. Overrides the Anthropic model used for step parsing and
# selector generation. Defaults to claude-sonnet-5.
ANTHROPIC_MODEL=claude-sonnet-5
